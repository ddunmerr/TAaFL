// Демонстрация возможностей языка Kitten для ручного запуска интерпретатора.
// Использует: main, print, readInt, min, max, sqr,
// арифметику, приоритеты, скобки, унарный минус.

func main() -> void {
    // Литералы и приоритеты.
    print(10 + 7 * (2 * 3 + 4) + 5 + -5);   // 80
    print((10 + 2) * 5);                     // 60
    print(10 - 3 - 2);                       // 5
    print(20 / 4);                           // 5
    print(-5);                               // -5
    print(-(2 + 3));                         // -5

    // Встроенные функции.
    print(min(3, 7));                        // 3
    print(max(3, 7));                        // 7
    print(sqr(5));                           // 25

    // Комбинация функций и арифметики.
    print(min(2, 3) + max(4, 5) * sqr(2));   // 22
    print(sqr(min(2, 3)) + max(1, 2));       // 6

    // Ввод.
    print(readInt() + 1);
    print(readInt() * 2);

    // Выражение как инструкция — результат отбрасывается.
    2 + 3;
    min(10, 20);
}